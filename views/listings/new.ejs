<% layout("/layouts/boilerplate") %>
<div class="row mt-3" >
  <div class="col-8 offset-2">

    <h3>Create a New Listing</h3>
    <br>
    <form method="POST" action="/listings"  class="needs-validation">

      <div class="mb-3" >
         <label for="title" class="form-lable ">Title</label>
        <input 
         name="listing[title]"
         placeholder="Add a catchy name"
         type="text"
         class="form-control"
         required
         />
         <div  class="invalid-feedback">please enter valid title</div>
        </div>
       

      <div class="mb-3">
        <label for="description" class="form-lable">Description</label>
        <textarea
        name="listing[description]"
        class="form-control"
         required
      ></textarea>
      <div  class="invalid-feedback">please enter valid discription</div>
      </div>
     

      <div class="mb-3">
        <label for="image" class="form-lable">Image Link</label>

      <input
        name="listing[image]"
        placeholder="enter image URL/Link"
        type="text"
        class="form-control"
        
      />
     <div  class="invalid-feedback">please enter valid image-url</div>

      </div>

      <div class="row ">
         <div class="mb-3 col-md-4">
          <label for="price" class="form-lable">Price</label>
          <input name="listing[price]" placeholder="1200" type="number" class="form-control" required/>
      
         <div  class="invalid-feedback">please enter valid Price</div>

      </div>
      <div class="mb-3 col-md-8  ">
        <label for="country" class="form-lable">Country Name</label>
         <input name="listing[country]" placeholder="India" type="text"  class="form-control"  required/>
        <div  class="invalid-feedback">please enter valid country</div>

      </div>
      <div class="mb-3">
          <label for="location" class="form-lable">Location</label>
          <input
        name="listing[location]"
        placeholder="enter location"
        type="text"
        class="form-control"
        required
      />
      <div  class="invalid-feedback">please enter valid location</div>
      
      </div>
       <br><br>
     <button class=" add_btn btn btn-dark mt-3">Add</button>
    <br><br>
       </form>
        
    </div>
  </div>
  